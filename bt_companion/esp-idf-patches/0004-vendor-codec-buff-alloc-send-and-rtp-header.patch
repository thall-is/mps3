diff --git a/components/bt/host/bluedroid/btc/profile/std/a2dp/btc_av.c b/components/bt/host/bluedroid/btc/profile/std/a2dp/btc_av.c
--- a/components/bt/host/bluedroid/btc/profile/std/a2dp/btc_av.c
