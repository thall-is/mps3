             buf_offset += latm_hdr;
             break;
         }
+#endif
+        case 0xFF:
+            // Non-A2DP / vendor codec: packet includes any payload/RTP headers already
+            break;
+
         default:
             return;
     }
@@ -2275,6 +2278,12 @@ btc_a2d_src_audio_data_send(esp_a2d_conn_hdl_t conn_hdl, esp_a2d_audio_buff_t *
