# ============================================================================
# sdkconfig.defaults - ESP32-S3-WROOM-1 N16R8
#   Flash : 16MB Quad SPI
#   PSRAM :  8MB Octal SPI
# ============================================================================

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# --- PSRAM (octal, no N16R8) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y
# Alocacoes (malloc() puro, sem heap_caps_malloc com capacidade explicita)
# menores que este limite SEMPRE vao pra RAM interna, nunca pra PSRAM -
# mesmo com PSRAM livre de sobra. A RAM interna aqui e' pequena (~238KB
# de uso geral, disputada com WiFi/USB/stacks de todas as tasks). Baixado
# de 4096 pra 512: o parser de M4A do esp_audio_codec (biblioteca de
# terceiros, malloc() puro, sem escolher onde alocar) falhava tentando
# alocar a tabela "stsc" - provavelmente pequena o bastante (<4096 bytes)
# pra cair nessa regra e nunca chegar a tentar a PSRAM, mesmo ela estando
# quase vazia. 512 ainda mantem coisas MUITO pequenas e frequentes (ex:
# mutexes, TCBs do FreeRTOS) na RAM interna rapida, sem sufocar alocacoes
# de tamanho moderado feitas por bibliotecas de terceiros que a gente nao
# controla.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512

# --- FATFS: nomes de arquivo longos (titulos de musica, subpastas) ---
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_CODEPAGE_850=y

# --- Stacks ---
# 4096 era insuficiente: load_last_track_index() (chamada sincrona a
# partir de app_main(), ou seja, roda na propria task "main") usa sozinha
# ~2.8KB de buffers de caminho na pilha (rel_path+rel_dir+filename+
# abs_dir), e o ABI com janelas de registrador do Xtensa gasta mais pilha
# por chamada aninhada do que se poderia esperar. Ja' estava no limite;
# confirmado por "***ERROR*** A stack overflow in task main has been
# detected" no log, logo ao entrar em load_last_track_index().
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- CPU a 240MHz para dar folga na decodificacao ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# --- USB MSC (modo "pendrive" pra' transferir musicas, via menu) ---
CONFIG_TINYUSB_MSC_ENABLED=y
# --- WiFi Transfer (modo "estacao"/"hotspot" pra' transferir musicas
# via navegador, via menu) - SSID/senha nao ficam aqui, sao configurados
# por "pio run -t menuconfig" -> "MPS3 WiFi Transfer" (viram parte do
# sdkconfig gerado, nao do codigo-fonte). Antes de usar o modo "WiFi:
# minha rede" pela primeira vez, configure o SSID/senha de casa la'. ---
# Buffer padrao do componente e' pequeno (poucas centenas de bytes) -
# cada transacao USB carrega so' isso, entao o overhead do protocolo
# domina o tempo total numa transferencia grande. 8192 e' o valor que a
# propria documentacao do componente aponta como "ponto de retorno
# decrescente" (acima disso o ganho e' marginal) - com 8MB de PSRAM
# sobrando, o custo de memoria e' irrelevante.
CONFIG_TINYUSB_MSC_BUFSIZE=8192

# --- lwIP: buffers de TCP maiores pra' transferencia via WiFi -----------
# Os defaults do lwIP no ESP-IDF sao pensados pra' varias conexoes
# pequenas/leves ao mesmo tempo (web server tipico), nao pra' uma unica
# conexao carregando um arquivo grande - a janela/buffer pequenos forcam
# mais round-trips do que o necessario. Como so' existe uma conexao ativa
# por vez aqui (o navegador enviando 1 arquivo), da' pra' gastar mais
# memoria por conexao sem problema.
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_MAX_ACTIVE_TCP=8

# --- Mdns
CONFIG_MDNS_ENABLED=y
