diff --git a/components/bt/host/bluedroid/btc/profile/std/a2dp/btc_av.c b/components/bt/host/bluedroid/btc/profile/std/a2dp/btc_av.c
index 3ad23fb..25ef132 100644
--- a/components/bt/host/bluedroid/btc/profile/std/a2dp/btc_av.c
+++ b/components/bt/host/bluedroid/btc/profile/std/a2dp/btc_av.c
@@ -1664,6 +1664,22 @@ static void btc_av_reg_sep(uint8_t tsep, uint8_t seid, esp_a2d_mcc_t *mcc)
             break;
         }
 #endif
+        case ESP_A2D_MCT_NON_A2DP: {
+            /* Vendor codec (ex: LDAC) - a pilha AVDTP em si (BTA_AvRegSEP)
+             * e' generica; so' montamos os bytes crus da Media Codec
+             * Capability aqui, no mesmo formato que A2D_BldSbcInfo() usa
+             * pros codecs conhecidos (LOSC + media_type + codec_type + CIE). */
+            codec_type = 0xFF; /* valor de codec_type do AVDTP pra' Non-A2DP;
+                                   nao ha' constante BTA_AV_CODEC_* nomeada
+                                   pra isso nesta versao do stack */
+            btc_av_cb.codec_caps[seid].id = 0xFF;
+            memset(btc_av_cb.codec_caps[seid].info, 0, AVDT_CODEC_SIZE);
+            btc_av_cb.codec_caps[seid].info[0] = 2 + ESP_A2D_CIE_LEN_LDAC; /* LOSC */
+            btc_av_cb.codec_caps[seid].info[1] = A2D_MEDIA_TYPE_AUDIO;
+            btc_av_cb.codec_caps[seid].info[2] = 0xFF;
+            memcpy(&btc_av_cb.codec_caps[seid].info[3], &mcc->cie.ldac_info, ESP_A2D_CIE_LEN_LDAC);
+            break;
+        }
         default: {
             param.a2d_sep_reg_stat.reg_state = ESP_A2D_SEP_REG_UNSUPPORTED;
             btc_a2d_cb_to_app(ESP_A2D_SEP_REG_STATE_EVT, &param);
